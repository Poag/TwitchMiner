# Copy to .env and edit. Only TCPM_USERNAME is required. See the README, "Settings", for every option.

TCPM_USERNAME=your-twitch-username
# Only needed for the first login (otherwise the miner asks interactively)
TCPM_PASSWORD=

# Everything the miner writes lives here: cookies/, database/, logs/, analytics/ (/data in Docker)
# TCPM_DATA_DIR=./data

# Streamers in priority order. Override defaults per streamer after a colon: name:follow_raid=false+chat=never
TCPM_STREAMERS=streamer-username01,streamer-username02:follow_raid=false+watch_streak=true,streamer-username03
# Set TCPM_FOLLOWERS=true to also mine every channel you follow on Twitch (added after TCPM_STREAMERS, minus the blacklist)
TCPM_FOLLOWERS=false
# TCPM_FOLLOWERS_ORDER=ASC
# TCPM_BLACKLIST=streamer-to-skip

# STREAK, DROPS, SUBSCRIBED, ORDER, POINTS_ASCENDING, POINTS_DESCENDING
TCPM_PRIORITY=STREAK,DROPS,ORDER
TCPM_CLAIM_DROPS_STARTUP=false
# Games whose drops are watched first (comma separated names). More can be ticked on the analytics page
# TCPM_PRIORITY_GAMES=Elim,Rust

# Defaults for every streamer
TCPM_FOLLOW_RAID=true
TCPM_CLAIM_DROPS=true
TCPM_WATCH_STREAK=true
TCPM_COMMUNITY_GOALS=false
# ALWAYS, NEVER, ONLINE, OFFLINE
TCPM_CHAT=ONLINE

# Analytics web page (uses more memory and disk). Use host 0.0.0.0 inside Docker
TCPM_ENABLE_ANALYTICS=false
# TCPM_ANALYTICS_HOST=0.0.0.0
# TCPM_ANALYTICS_PORT=5000
# TCPM_ANALYTICS_REFRESH=5
# TCPM_ANALYTICS_DAYS_AGO=7

# Logging
TCPM_LOG_SAVE=true
TCPM_LOG_CONSOLE_LEVEL=INFO
TCPM_LOG_FILE_LEVEL=DEBUG
# TCPM_LOG_CONSOLE_USERNAME=false
# TCPM_LOG_LESS=false
# TCPM_LOG_COLORED=true
# TCPM_LOG_EMOJI=true
# TCPM_TIME_ZONE=Europe/London
# TCPM_COLOR_STREAMER_ONLINE=GREEN

# Advanced
# TCPM_DISABLE_SSL_CERT_VERIFICATION=false
# TCPM_DISABLE_AT_IN_NICKNAME=false

# Notifications: set the required variables to enable one. Events: STREAMER_ONLINE, STREAMER_OFFLINE, GAIN_FOR_RAID,
# GAIN_FOR_CLAIM, GAIN_FOR_WATCH, BONUS_CLAIM, JOIN_RAID, DROP_CLAIM, DROP_STATUS, CHAT_MENTION
# TCPM_TELEGRAM_CHAT_ID=
# TCPM_TELEGRAM_TOKEN=
# TCPM_TELEGRAM_EVENTS=STREAMER_ONLINE,STREAMER_OFFLINE,CHAT_MENTION
# TCPM_TELEGRAM_DISABLE_NOTIFICATION=false
# TCPM_DISCORD_WEBHOOK_API=
# TCPM_DISCORD_EVENTS=STREAMER_ONLINE,STREAMER_OFFLINE,CHAT_MENTION,DROP_CLAIM
# TCPM_WEBHOOK_ENDPOINT=
# TCPM_WEBHOOK_METHOD=GET
# TCPM_MATRIX_USERNAME=
# TCPM_MATRIX_PASSWORD=
# TCPM_MATRIX_HOMESERVER=matrix.org
# TCPM_MATRIX_ROOM_ID=
# TCPM_PUSHOVER_USERKEY=
# TCPM_PUSHOVER_TOKEN=
# TCPM_PUSHOVER_PRIORITY=0
# TCPM_PUSHOVER_SOUND=pushover
# TCPM_GOTIFY_ENDPOINT=https://example.com/message?token=TOKEN
# TCPM_GOTIFY_PRIORITY=8
